# EchoChamber API Keys
# Copy this file to .env and fill in your keys.
# Only the providers you actually use need a key — LM Studio (local) needs none.

# Anthropic (Claude) — for --*-provider anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT-4o) — for --*-provider openai
OPENAI_API_KEY=sk-...

# Together.AI — for --*-provider together
TOGETHER_API_KEY=tgp_v1_...

# Google Gemini — for --*-provider gemini
GEMINI_API_KEY=AIza...
